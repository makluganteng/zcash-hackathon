# Copy to .env.local. Never commit .env.local or private keys.
# Use a separate database, account, registry and secrets for each deployment.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://auction_dev@127.0.0.1:55432/sealed_auctions
# Supabase: copy Connect > Session pooler (5432), with verified TLS.
# Do not use transaction pooler (6543): this app uses session advisory locks.
# Keep DATABASE_URL server-only; no Supabase anon/service-role key is needed.
DATABASE_POOL_MAX=2
# For Supabase, use the PEM from Database Settings > Download certificate.
# Store the multiline PEM in a quoted value; hostname/certificate checks stay on.
DATABASE_SSL_CA=
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
REGISTRY_ADDRESS=
EXPECTED_VERIFIER_ADDRESS=

# Fund this testnet-only relay with Base Sepolia ETH. It never holds ZEC.
RELAY_PRIVATE_KEY=
# Independent EIP-191 invoice signing key; do not reuse the relay key.
INVOICE_PRIVATE_KEY=
# Long random operator bearer token used only in seller browser requests.
OPERATOR_TOKEN=

# Run npm run keys:generate -- .data/keys. Set PUBLIC_JWK to the single-line public JSON.
# No d/p/q/dp/dq/qi private RSA fields may appear in EVALUATOR_PUBLIC_JWK.
EVALUATOR_PUBLIC_JWK=
# Worker only; mount this file on the worker, never in a public bundle.
EVALUATOR_PRIVATE_JWK_PATH=.data/keys/evaluator-private.jwk.json
DRAND_MARGIN_SECONDS=120

# Dedicated seller testnet shielded destination. No default/fake recipient.
SELLER_ZCASH_ADDRESS=
# Optional receiver integration. No payment can be marked confirmed without it.
# Explicit scanner backend; omitted defaults to zallet. Worker-only settings below.
ZCASH_SCANNER_BACKEND=zallet
# Zallet requires imported viewing material for this dedicated account, no spend key.
ZALLET_RPC_URL=
ZALLET_RPC_AUTH=
ZALLET_ACCOUNT_UUID=
# Read-only Zebra/node RPC; getblockchaininfo must report chain="test".
ZCASH_NODE_RPC_URL=
ZCASH_NODE_RPC_AUTH=
ZCASH_CONFIRMATIONS=3
# Alternative: ZCASH_SCANNER_BACKEND=devtool. Requires the tested NU7 build and
# a dedicated imported UFVK-only wallet. Never point this at a spending wallet.
# Readiness requires a fresh complete snapshot and official SDK seller ownership.
# The helper matches exact shielded receivers per pool across UA revisions.
ZCASH_VIEW_WALLET_PATH=
ZCASH_WALLET_BINARY=
ZCASH_ADDRESS_VERIFIER_BINARY=
ZCASH_ACCOUNT_UUID=

# For local Anvil only (not production): BASE_CHAIN_ID=31337,
# BASE_RPC_URL=http://127.0.0.1:8545. Mine 64+ blocks for finalized-tag reads.
